# Paths derive from this file's location so the repo is relocatable
# (server deployments). Every var can be overridden by pre-set env.
_GAP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-.}")" >/dev/null 2>&1 && pwd)"

export ROBOTWIN_ROOT="${ROBOTWIN_ROOT:-$(dirname "$_GAP_ROOT")/RoboTwin}"
export WANDB_MODE="${WANDB_MODE:-online}"
export GAP_PRETRAINED_ROOT="${GAP_PRETRAINED_ROOT:-$_GAP_ROOT/pretrained}"
export PI3_MODEL_NAME_OR_PATH="${PI3_MODEL_NAME_OR_PATH:-$_GAP_ROOT/pretrained/Pi3}"
export DINOV3_WEIGHTS_PATH="${DINOV3_WEIGHTS_PATH:-$_GAP_ROOT/pretrained/dinov3_vitl16_pretrain_lvd1689m-8aa4cbdd.pth}"
export DINOV3_REPO_DIR="${DINOV3_REPO_DIR:-$_GAP_ROOT/thirdparty/dinov3}"
export DINOV2_WEIGHTS_PATH="${DINOV2_WEIGHTS_PATH:-$_GAP_ROOT/pretrained/dinov2_vitl14_reg4_pretrain.pth}"
export DINOV2_REPO_DIR="${DINOV2_REPO_DIR:-$_GAP_ROOT/thirdparty/dinov2}"
export RAW_DATA_ROOT="${RAW_DATA_ROOT:-$ROBOTWIN_ROOT/data}"
export OUTPUT_ROOT="${OUTPUT_ROOT:-$_GAP_ROOT/data}"
